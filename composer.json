{
    "name": "componenta/iterator",
    "description": "Iterator helpers and replayable iterators for Componenta packages",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "componenta/arrayable": "^1.0"
    },
    "require-dev": {
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Stdlib\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Stdlib\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
